{
  "name": "resale-prep",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite --host --mode mock",
    "build": "tsc -b && vite build",
    "build:api": "npm --prefix api run build",
    "lint": "oxlint",
    "preview": "vite preview --host",
    "test": "vitest run",
    "icons": "pwa-assets-generator --preset minimal-2023 scripts/icon.svg && node scripts/move-icons.mjs"
  },
  "dependencies": {
    "@fontsource/archivo": "^5.2.8",
    "idb": "^8.0.3",
    "react": "^19.2.8",
    "react-dom": "^19.2.8"
  },
  "devDependencies": {
    "@types/node": "^24.13.3",
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vite-pwa/assets-generator": "^1.0.0",
    "@vitejs/plugin-react": "^6.0.4",
    "oxlint": "^1.75.0",
    "typescript": "~6.0.2",
    "vite": "^8.2.0",
    "vite-plugin-pwa": "^1.3.0",
    "vitest": "^4.1.11"
  },
  "allowScripts": {
    "azure-functions-core-tools@4.15.2": true
  }
}
